{
  "name": "community",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "wrangler dev .output/server/index.mjs --assets .output/public",
    "deploy": "nuxt build && wrangler deploy",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:init": "wrangler d1 execute waline-db --remote --file=./layers/waline/schema.sql",
    "db:init:local": "wrangler d1 execute waline-db --local --file=./layers/waline/schema.sql",
    "db:migrate:electives": "wrangler d1 execute waline-db --remote --file=./migrations/2026-09-15-elective-reviews.sql",
    "db:migrate:electives:local": "wrangler d1 execute waline-db --local --file=./migrations/2026-09-15-elective-reviews.sql",
    "format": "prettier --write ./**/*.{js,ts,tsx,vue,json}"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@iconify-json/lucide": "^1.2.135",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.136.1"
  }
}
